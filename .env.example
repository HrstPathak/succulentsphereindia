# Hugging Face Inference API (for chatbot)
# Get your token at https://huggingface.co/settings/tokens
HF_TOKEN=
# Alternative: HUGGINGFACE_TOKEN=

# Optional: Pick model (router.huggingface.co / Inference Providers)
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional provider failover order for chatbot (default: ollama,openrouter,hf)
# LLM_PROVIDER_ORDER=ollama,openrouter,hf
# LLM_PROVIDER_TIMEOUT_MS=10000
# OPENROUTER_PROVIDER_TIMEOUT_MS=25000
# OLLAMA_PROVIDER_TIMEOUT_MS=10000
# HF_PROVIDER_TIMEOUT_MS=10000

# OpenRouter (OpenAI-compatible)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_SITE_NAME=SucculentSphere

# Ollama (local, fully free)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b

# Razorpay
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Transactional order email (Resend)
# Create a key at https://resend.com/api-keys and verify the sender domain first.
# RESEND_API_KEY=
# ORDER_EMAIL_FROM=Succulent Sphere <orders@succulentsphere.com>

# Free Gmail alternative (use one provider only). Turn on Google 2-Step Verification,
# create a 16-character App Password, and never place your normal Gmail password here.
# GMAIL_USER=succulentsphere@gmail.com
# GMAIL_APP_PASSWORD=
# GMAIL_FROM_NAME=Succulent Sphere

# Private store-control dashboard. Comma-separated Firebase login email(s).
# Leave empty until you add your own email; access fails closed.
# ADMIN_EMAILS=owner@succulentsphere.com

# Delhivery B2C shipment creation. The endpoint and required fields are supplied
# by the Delhivery One Developer Portal for your account. A paid order creates a
# durable shipment job; CRON_SECRET enables safe automatic retries.
# DELHIVERY_API_TOKEN=
# DELHIVERY_CREATE_URL=
# DELHIVERY_PICKUP_LOCATION=
# DELHIVERY_SELLER_NAME=Succulent Sphere
# DELHIVERY_SHIPPING_MODE=Surface
# DELHIVERY_PACKAGE_TYPE=Cardboard Box
# DELHIVERY_PACKAGE_LENGTH_CM=14
# DELHIVERY_PACKAGE_BREADTH_CM=12
# DELHIVERY_PACKAGE_HEIGHT_CM=12
# DELHIVERY_PACKAGE_WEIGHT_GM=450
# CRON_SECRET=

# Upstash Redis (Vercel KV)
# Required for auto-refresh token caching and Razorpay checkout recovery
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Google Tag Manager
# Example: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Public production URL used by the Meta catalogue data feed.
# Example: https://succulentsphere.com
NEXT_PUBLIC_SITE_URL=

# Google Analytics (optional direct gtag loading)
# Example: G-XXXXXXXXXX
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta/Facebook Pixel (optional)
# Example: 123456789012345
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
