# Hugging Face Inference API (for chatbot)
# Get your token at https://huggingface.co/settings/tokens
HF_TOKEN=
# Alternative: HUGGINGFACE_TOKEN=

# Optional: Pick model (router.huggingface.co / Inference Providers)
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional provider failover order (default: gemini,ollama,openrouter,hf)
# LLM_PROVIDER_ORDER=gemini,openrouter,hf,ollama
# LLM_PROVIDER_TIMEOUT_MS=10000
# GEMINI_PROVIDER_TIMEOUT_MS=25000
# OPENROUTER_PROVIDER_TIMEOUT_MS=25000
# OLLAMA_PROVIDER_TIMEOUT_MS=10000
# HF_PROVIDER_TIMEOUT_MS=10000

# ── Google Gemini (PRIMARY LLM — blog automation + chatbot) ─────────────────
# 1. Sign in at https://aistudio.google.com with any Google account
# 2. Open https://aistudio.google.com/apikey → "Create API key"
# 3. Paste the key below (it starts with "AIza..."). Never commit it.
# The free tier easily covers this app's cron (3 blog runs/week). On 429 / 5xx /
# timeout / bad JSON the run automatically falls back to the OpenRouter chain.
# GEMINI_API_KEY=
# "gemini-flash-latest" auto-tracks the newest stable Flash model, so the cron
# never breaks on a deprecation. Verify alternatives (e.g.
# gemini-flash-lite-latest for the cheapest tier) at
# https://ai.google.dev/gemini-api/docs/models before changing — do not guess.
# GEMINI_MODEL=gemini-flash-latest
# Thinking models spend reasoning tokens BEFORE the JSON, so the Gemini attempt
# gets a larger output budget than the OpenRouter slots (BLOG_MAX_NEW_TOKENS).
# GEMINI_BLOG_MAX_NEW_TOKENS=8192
# Transient Gemini failures (429 / 5xx / provider timeout / network) are
# retried before falling back to OpenRouter — the free tier's "high demand"
# 503s are temporary. Defaults shown; GEMINI_MAX_ATTEMPTS=1 disables retrying.
# GEMINI_MAX_ATTEMPTS=2
# GEMINI_RETRY_DELAY_MS=10000

# OpenRouter (OpenAI-compatible)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_SITE_NAME=SucculentSphere

# Blog automation FALLBACK chain (OpenRouter model IDs) — used ONLY when the
# Gemini attempt above fails or GEMINI_API_KEY is not set.
# Tried in order AUTOMATION_MODEL_1 -> _2 -> ... -> _6; empty values are skipped.
# Verify free model IDs on https://openrouter.ai/models before setting slots —
# do not guess. When none are set, the shared OPENROUTER_MODEL / HF_MODEL
# config above is used instead (Gemini still goes first).
# AUTOMATION_MODEL_1=
# AUTOMATION_MODEL_2=
# AUTOMATION_MODEL_3=
# AUTOMATION_MODEL_4=
# AUTOMATION_MODEL_5=
# AUTOMATION_MODEL_6=

# Ollama (local, fully free)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b

# Razorpay
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Transactional order email (Resend)
# Create a key at https://resend.com/api-keys and verify the sender domain first.
# RESEND_API_KEY=
# ORDER_EMAIL_FROM=Succulent Sphere <orders@succulentsphere.com>

# Free Gmail alternative (use one provider only). Turn on Google 2-Step Verification,
# create a 16-character App Password, and never place your normal Gmail password here.
# GMAIL_USER=succulentsphere@gmail.com
# GMAIL_APP_PASSWORD=
# GMAIL_FROM_NAME=Succulent Sphere

# Private store-control dashboard. Comma-separated Firebase login email(s).
# Leave empty until you add your own email; access fails closed.
# ADMIN_EMAILS=owner@succulentsphere.com

# Delhivery B2C shipment creation. The endpoint and required fields are supplied
# by the Delhivery One Developer Portal for your account. A paid order creates a
# durable shipment job; CRON_SECRET enables safe automatic retries.
# DELHIVERY_API_TOKEN=
# DELHIVERY_CREATE_URL=
# DELHIVERY_PICKUP_LOCATION=
# DELHIVERY_SELLER_NAME=Succulent Sphere
# DELHIVERY_SHIPPING_MODE=Surface
# DELHIVERY_PACKAGE_TYPE=Cardboard Box
# DELHIVERY_PACKAGE_LENGTH_CM=14
# DELHIVERY_PACKAGE_BREADTH_CM=12
# DELHIVERY_PACKAGE_HEIGHT_CM=12
# DELHIVERY_PACKAGE_WEIGHT_GM=450
# CRON_SECRET=

# Optional product image upload for admin add-product flow. When configured,
# uploaded files are pushed to your Hostinger file endpoint before saving.
# HOSTINGER_UPLOAD_URL=
# HOSTINGER_UPLOAD_TOKEN=
# HOSTINGER_UPLOAD_DIR=sites/images
# NEXT_PUBLIC_MEDIA_BASE_URL=https://your-public-media-domain.com

# Upstash Redis (Vercel KV)
# Required for Razorpay checkout recovery
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Google Tag Manager
# Example: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Public production URL used by the Meta catalogue data feed.
# Example: https://succulentsphere.com
NEXT_PUBLIC_SITE_URL=

# Google Analytics (optional direct gtag loading)
# Example: G-XXXXXXXXXX
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta/Facebook Pixel (optional)
# Example: 123456789012345
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
