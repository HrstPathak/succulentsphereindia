{
  "name": "succulent-sphere-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "firebase:auth:smoke": "node --env-file=.env.local scripts/firebase-auth-smoke.cjs",
    "firebase:session:smoke": "node --env-file=.env.local scripts/firebase-session-handoff-smoke.cjs",
    "delhivery:shipment:test": "node scripts/delhivery-shipment-smoke.cjs",
    "order:email:test": "node scripts/order-email-smoke.cjs",
    "order:email:send-test": "node --env-file=.env.local scripts/order-email-send-test.cjs",
    "order:email:build": "tsc -p tsconfig.email-preview.json",
    "order:email:verify": "npm run order:email:build && node email-preview/verify.cjs",
    "order:confirmation:verify": "npm run order:email:build && node email-preview/verify-confirmation.cjs",
    "email:verify": "npm run order:email:verify && npm run order:confirmation:verify",
    "email:preview": "node email-preview/shoot.cjs && node email-preview/shoot-confirmation.cjs",
    "email:assets": "node scripts/build-email-assets.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@upstash/redis": "^1.36.4",
    "autoprefixer": "^10.4.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.6.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.408.0",
    "next": "^16.1.6",
    "nodemailer": "^9.0.5",
    "postcss": "^8.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-toastify": "^11.1.0",
    "redis": "^4.6.7",
    "swr": "^2.4.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.0",
    "typescript": "^5.3.0"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "^16.1.6"
  }
}
